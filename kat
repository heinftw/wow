local function createTracerLine()
    local line = Drawing.new("Line")
    line.Visible, line.Color, line.Thickness = false, cfg.tracerColor, cfg.tracerThickness
    return line
end

local function updateTracer(p, line)
    if not cfg.tracer or not p.Character then line.Visible = false; return end
    local hum, hrp = p.Character:FindFirstChild("Humanoid"), p.Character:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then line.Visible = false; return end

    local pos, vis = cam:WorldToViewportPoint(hrp.Position)
    if not vis then line.Visible = false; return end

    line.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
    line.To = Vector2.new(pos.X, pos.Y)
    line.Visible, line.Color, line.Thickness = true, cfg.tracerColor, cfg.tracerThickness
end

local function setupTracer(p)
    if p == lp then return end
    local line = createTracerLine()
    tracers[p] = line

    local conn = rs.RenderStepped:Connect(function() updateTracer(p, line) end)
    p.AncestryChanged:Connect(function()
        if not p.Parent then
            conn:Disconnect()
            line:Remove()
            tracers[p] = nil
        end
    end)
    p.CharacterAdded:Connect(function() updateTracer(p, line) end)
end

for _, p in ipairs(plrs:GetPlayers()) do if p ~= lp then setupTracer(p) end end
plrs.PlayerAdded:Connect(function(p) if p ~= lp then setupTracer(p) end end)
plrs.PlayerRemoving:Connect(function(p)
    local line = tracers[p]
    if line then line:Remove(); tracers[p] = nil end
end)

local fovCircle = Drawing.new("Circle")
fovCircle.Visible, fovCircle.Thickness, fovCircle.Color, fovCircle.ZIndex = cfg.silentCfg.showFov, 2, cfg.silentCol, 2

local function getSilentTarget(maxFov)
    local target, closest = nil, maxFov or math.huge
    for _, p in pairs(plrs:GetPlayers()) do
        if p ~= lp and p.Character and p.Character:FindFirstChild(cfg.silentCfg.hitbox) then
            local pos, vis = cam:WorldToScreenPoint(p.Character[cfg.silentCfg.hitbox].Position)
            local mousePos = lp:GetMouse()
            local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(mousePos.X, mousePos.Y)).Magnitude
            if dist < closest and vis then
                closest, target = dist, p
            end
        end
    end
    return target
end

rs.Stepped:Connect(function()
    fovCircle.Visible = cfg.silentCfg.showFov
    if cfg.silentCfg.showFov then
        local mousePos = lp:GetMouse()
        fovCircle.Radius = cfg.silentCfg.fov
        fovCircle.Position = Vector2.new(mousePos.X, mousePos.Y + 36)
        fovCircle.Thickness = cfg.silentThick
        fovCircle.Color = cfg.silentCol
    end
    targetSilent = getSilentTarget(cfg.silentCfg.fov)
end)

local oldNc
oldNc = hookmetamethod(game, "__namecall", function(self, ...)
    local args = { ... }
    if not checkcaller() and getnamecallmethod() == "FindPartOnRayWithIgnoreList" then
        if table.find(args[2], ws.WorldIgnore.Ignore) and targetSilent and targetSilent.Character and cfg.silent then
            pcall(function()
                local origin = args[1].Origin
                args[1] = Ray.new(origin, targetSilent.Character[cfg.silentCfg.hitbox].Position - origin)
            end)
        end
    end
    return oldNc(self, unpack(args))
end)

