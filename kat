        if lp.Character and lp.Character:FindFirstChild("Humanoid") then lp.Character.Humanoid.Health = 0 end
    end
end

local function createJumpEffect(pos)
    local part = Instance.new("Part")
    part.Anchored, part.CanCollide, part.Transparency, part.Color, part.Size = true, false, 0.3, cfg.jumpEffectColor, Vector3.new(1, 1, 1)
    part.Material, part.CFrame = Enum.Material.Neon, CFrame.new(pos)

    local mesh = Instance.new("SpecialMesh", part)
    mesh.MeshType, mesh.MeshId, mesh.Scale = Enum.MeshType.FileMesh, "rbxassetid://12640007832", Vector3.new(0.1, 0.1, 0.1)
    part.Parent = ws

    local t1 = ts:Create(mesh, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = Vector3.new(1.5, 1.5, 1.5) })
    local t2 = ts:Create(part, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 })

    t1:Play()
    t1.Completed:Connect(function()
        t2:Play()
        t2.Completed:Connect(function() part:Destroy() end)
    end)
end

local function hookJumpEffect(chr)
