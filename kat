local function createEspBox(p)
    local sq = Drawing.new("Square")
    sq.Visible, sq.Transparency, sq.Filled, sq.Color, sq.Thickness = false, 1, false, p.TeamColor.Color, 1

    rs.RenderStepped:Connect(function()
        if cfg.esp and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character:FindFirstChild("HumanoidRootPart") and p ~= lp and p.Character.Humanoid.Health > 0 then
            local hrp, head = p.Character.HumanoidRootPart, p.Character.Head
            local hrpPos, vis1 = cam:worldToViewportPoint(hrp.Position)
            local headPos = cam:worldToViewportPoint(head.Position + Vector3.new(0, 2, 0))
            local feetPos = cam:worldToViewportPoint(hrp.Position - Vector3.new(0, 0.5, 0))

            sq.Size = Vector2.new(cfg.espW / hrpPos.Z, (headPos.Y - feetPos.Y) * cfg.espH)
            sq.Position = Vector2.new(hrpPos.X - (sq.Size.X / 2), hrpPos.Y - (sq.Size.Y / 2))
            sq.Visible = vis1
        else
            sq.Visible = false
        end
    end)
end

