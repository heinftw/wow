local function getValidFarmTargets()
    local valid = {}
    for _, p in ipairs(plrs:GetPlayers()) do
        if p ~= lp and p.Character then
            local hum, hrp = p.Character:FindFirstChildOfClass("Humanoid"), p.Character:FindFirstChild("HumanoidRootPart")
            local spawnTime = spawnTimes[p] or 0
            if hum and hum.Health > 0 and hrp and (os.clock() - spawnTime >= 1.5) then
                table.insert(valid, p)
            end
        end
    end
    return valid
end

local function hasTool(p, name)
    if not p.Character then return false end
    if p.Character:FindFirstChild(name) then return true end
    local bp = p:FindFirstChild("Backpack")
    return bp and bp:FindFirstChild(name) ~= nil
end

local function getMovers(part)
    local posAlign, rotAlign = part:FindFirstChild("PositionAlign"), part:FindFirstChild("RotationAlign")
    if not posAlign then
        local att = Instance.new("Attachment", part)
        att.Name = "MoverAttachment"

        posAlign = Instance.new("AlignPosition", part)
        posAlign.Name, posAlign.Mode, posAlign.MaxForce, posAlign.MaxVelocity, posAlign.Responsiveness, posAlign.Attachment0 = "PositionAlign", Enum.PositionAlignmentMode.OneAttachment, 999999999, math.huge, 100000, att

        rotAlign = Instance.new("AlignOrientation", part)
        rotAlign.Name, rotAlign.MaxTorque, rotAlign.Responsiveness, rotAlign.Attachment0, rotAlign.Mode = "RotationAlign", 1000000000, 100000, att, Enum.OrientationAlignmentMode.OneAttachment
    end
    return posAlign, rotAlign
end

local function speedupKnife(chr)
    local knife = chr:FindFirstChild("Knife")
    if knife and knife:FindFirstChild("KnifeServer") and knife.KnifeServer:FindFirstChild("KnifeClient") then
        local env = getsenv(knife.KnifeServer.KnifeClient)
        if env and env.ClientKnifeSettings then
            env.ClientKnifeSettings.EquipTime = 0.001
            env.ClientKnifeSettings.SlashTime = 0.001
        end
    end
end

local function equipKnife(chr)
    local bp = lp:FindFirstChild("Backpack")
    if bp then
        local knife = bp:FindFirstChild("Knife")
        if knife then
            knife.Parent = chr
            speedupKnife(chr)
        end
    end
end

