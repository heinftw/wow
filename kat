local function startFarm()
    if conns.farm then conns.farm:Disconnect() end
    local lastTargetTime, targetTimeout, lastPressTime, pressInterval = 0, 0.2, 0, 0.05

    local function findPriorityTarget()
        local m, s
        for _, p in ipairs(getValidFarmTargets()) do
            if hasTool(p, "Knife") then m = p
            elseif hasTool(p, "Revolver") then s = p end
        end
        return m or s
    end

    conns.farm = rs.Heartbeat:Connect(function()
        if not cfg.farming or not lp.Character then return end
        local chr = lp.Character
        local hrp = chr:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        for _, v in pairs(chr:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end

        equipKnife(chr)
        local posAlign, rotAlign = getMovers(hrp)
        local targets = getValidFarmTargets()

        local invalidTarget = not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local priorityTarget = findPriorityTarget()

        if priorityTarget then
            targetPlayer, lastTargetTime = priorityTarget, os.clock()
        elseif invalidTarget or (os.clock() - lastTargetTime >= targetTimeout) then
            targetPlayer = #targets > 0 and targets[math.random(1, #targets)] or nil
            lastTargetTime = os.clock()
        end

        local tHrp = targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tHrp then
            posAlign.Position = tHrp.Position + Vector3.new(0, -0.5, 0)
            rotAlign.CFrame = CFrame.lookAt(hrp.Position, tHrp.Position)
            if os.clock() - lastPressTime >= pressInterval then
                pressE()
                lastPressTime = os.clock()
            end
        end
    end)

    if conns.knifeUpdater then conns.knifeUpdater:Disconnect() end
    conns.knifeUpdater = rs.Heartbeat:Connect(function()
        if cfg.farming and lp.Character then speedupKnife(lp.Character) end
    end)

    lp.CharacterAdded:Connect(function(c)
        task.wait(0.1)
        equipKnife(c)
    end)
end

local function toggleFarm(state)
    cfg.farming = state
    if state then
