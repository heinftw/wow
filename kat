local function updateSpeed()
    if speedConn then speedConn:Disconnect() end
    if cfg.speed then
        speedConn = rs.Heartbeat:Connect(function()
            if lp.Character then
                local hrp, hum = lp.Character:FindFirstChild("HumanoidRootPart"), lp.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.MoveDirection.Magnitude > 0 then
                    hrp.CFrame += (hum.MoveDirection * cfg.speedVal)
                end
            end
        end)
    end
end

local function updateFly()
    if not cfg.fly or not lp.Character then return end
    local hrp = lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dir = Vector3.zero
    if keys.w then dir += cam.CFrame.LookVector end
    if keys.s then dir -= cam.CFrame.LookVector end
    if keys.a then dir -= cam.CFrame.RightVector end
    if keys.d then dir += cam.CFrame.RightVector end
    if keys.space then dir += Vector3.new(0, 1, 0) end
    if keys.shift then dir -= Vector3.new(0, 1, 0) end

    if dir.Magnitude > 0 then
        dir = dir.Unit * cfg.flySpeed
        hrp.CFrame += dir
    end
    hrp.Velocity = Vector3.new(hrp.Velocity.X, 0, hrp.Velocity.Z)
end

